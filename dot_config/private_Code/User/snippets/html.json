"Layout Semántico Grid": {
    "prefix": "html-layout",
    "body": [
        "",
        "<div class=\"layout-grid\" style=\"display: grid; gap: 20px; grid-template-areas: 'header' 'main' 'sidebar' 'footer';\">",
        "    ",
        "    <header style=\"grid-area: header;\">",
        "        <h1>${1:Título Principal}</h1>",
        "    </header>",
        "",
        "    ",
        "    <main style=\"grid-area: main;\">",
        "        <article>",
        "            <h2>${2:Título del Artículo}</h2>",
        "            <p>${3:Contenido...}</p>",
        "        </article>",
        "    </main>",
        "",
        "    ",
        "    <aside style=\"grid-area: sidebar;\">",
        "        <h3>Relacionado</h3>",
        "        <ul>",
        "            <li><a href=\"#\">Link 1</a></li>",
        "        </ul>",
        "    </aside>",
        "",
        "    ",
        "    <footer style=\"grid-area: footer;\">",
        "        <small>Footer Content</small>",
        "    </footer>",
        "</div>",
        "",
        "",
        "$0"
    ],
    "description": "Layout semántico preparado para CSS Grid"
},
"Formulario Pro Completo": {
    "prefix": "html-form-pro",
    "body": [
        "<form action=\"${1:servidor.php}\" method=\"${2|POST,GET|}\" enctype=\"multipart/form-data\" class=\"form-grid\">",
        "    <fieldset style=\"border: 1px solid #ccc; padding: 1rem; border-radius: 8px;\">",
        "        <legend>${3:Datos de Contacto}</legend>",
        "",
        "        ",
        "        <div class=\"input-group\">",
        "            <label for=\"nombre\">Nombre Completo:</label>",
        "            <input type=\"text\" id=\"nombre\" name=\"nombre\" placeholder=\"Ej: Juan Pérez\" required autocomplete=\"name\" minlength=\"2\">",
        "        </div>",
        "",
        "        ",
        "        <div class=\"input-group\">",
        "            <label for=\"email\">Correo Electrónico:</label>",
        "            <input type=\"email\" id=\"email\" name=\"email\" placeholder=\"usuario@email.com\" required autocomplete=\"email\">",
        "        </div>",
        "",
        "        ",
        "        <div class=\"input-group\">",
        "            <label for=\"password\">Contraseña:</label>",
        "            <input type=\"password\" id=\"password\" name=\"password\" required minlength=\"8\" pattern=\"(?=.*\\d)(?=.*[a-z])(?=.*[A-Z]).{8,}\" title=\"Debe contener al menos 8 caracteres, una mayúscula y un número.\">",
        "        </div>",
        "",
        "        ",
        "        <div class=\"row\" style=\"display: flex; gap: 1rem;\">",
        "            <div class=\"input-group\">",
        "                <label for=\"pais\">País:</label>",
        "                <select id=\"pais\" name=\"pais\">",
        "                    <option value=\"\" disabled selected>Selecciona...</option>",
        "                    <option value=\"bo\">Bolivia</option>",
        "                    <option value=\"mx\">México</option>",
        "                </select>",
        "            </div>",
        "            <div class=\"input-group\">",
        "                <label for=\"nacimiento\">Fecha de Nacimiento:</label>",
        "                <input type=\"date\" id=\"nacimiento\" name=\"nacimiento\">",
        "            </div>",
        "        </div>",
        "",
        "        ",
        "        <div class=\"input-group\">",
        "            <label for=\"cv\">Subir CV (PDF):</label>",
        "            <input type=\"file\" id=\"cv\" name=\"cv\" accept=\".pdf\">",
        "        </div>",
        "",
        "        ",
        "        <div class=\"input-group checkbox\">",
        "            <input type=\"checkbox\" id=\"terminos\" name=\"terminos\" required>",
        "            <label for=\"terminos\">Acepto los <a href=\"#\">Términos y Condiciones</a></label>",
        "        </div>",
        "",
        "        <button type=\"submit\" style=\"margin-top: 1rem; padding: 0.5rem 1rem; cursor: pointer;\">Enviar Formulario</button>",
        "    </fieldset>",
        "</form>",
        "$0"
    ],
    "description": "Formulario seguro y completo con validaciones HTML5"
},

[Unit]
Description=Daemon de Piper para lectura en voz alta (SUPER+R) - mantiene el modelo cargado en memoria
After=graphical-session.target
# RTX: piper-tts viene del AUR (paquete de sistema), así que se usa /usr/bin/python3 que trae el módulo `piper`.
# Voces del paquete piper-voices-es-* en /usr/share/piper-voices.
ConditionPathExists=/usr/bin/python3

[Service]
Type=simple
# Voces bajadas de Hugging Face (ver 04-voz-servicios.sh)
Environment=PIPER_VOICES_DIR=/usr/share/piper-voices
ExecStart=/usr/bin/python3 %h/.config/hypr/scripts/piper-daemon.py
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target

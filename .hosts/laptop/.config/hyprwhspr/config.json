{
  "$schema": "https://raw.githubusercontent.com/goodroot/hyprwhspr/main/share/config.schema.json",
  "primary_shortcut": "SUPER+ALT+Z",
  "secondary_shortcut": "SUPER+ALT+X",
  "secondary_language": "en",
  "recording_mode": "toggle",
  "model": "small",
  "language": "es",
  "filter_filler_words": true,
  "filler_words": [
    "uh",
    "um",
    "er",
    "ah",
    "eh",
    "ehh",
    "mmm"
  ],
  "pywhispercpp_use_vad": true,
  "symbol_replacements": true,
  "transcription_backend": "pywhispercpp"
}
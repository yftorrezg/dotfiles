#!/usr/bin/env bash
# dotsync — mantiene la config de la PC y la laptop a la par (chezmoi + GitHub privado).
#
#   dotsync            = dotsync auto
#   dotsync auto       sube tus cambios, baja los del otro equipo y los aplica (lo usa el timer)
#   dotsync subir      solo guarda y sube tus cambios
#   dotsync bajar      solo baja y aplica los del otro equipo
#   dotsync estado     qué cambió aquí y qué falta subir/bajar
#   dotsync activar    habilita la sincronización automática (timer cada 30 min + al iniciar)
#   dotsync desactivar la apaga
#
# Archivos "por equipo" (monitores, NVIDIA, touchpad...): viven en el repo en
# .hosts/<pc|laptop>/ y la lista está en .hosts-lista. Todo lo demás es común.
# Detalles: ~/.local/share/chezmoi/README.md
set -uo pipefail
export PATH="$HOME/.local/bin:$PATH"

# Un solo dotsync a la vez (timer + manual podían chocar al hacer push).
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/dotsync.lock"
flock -w 120 9 || { echo "dotsync: ya hay otro corriendo"; exit 0; }

SRC=$(chezmoi source-path 2>/dev/null) || { echo "chezmoi no está inicializado"; exit 1; }
EQ=$(chezmoi execute-template '{{ .equipo }}')
LISTA="$SRC/.hosts-lista"
MARCA="$SRC/.hosts/$EQ/.fusion-inicial-hecha"

msg()  { echo "dotsync: $*"; }
avisa() { notify-send -a dotsync -u "${3:-normal}" "$1" "$2" 2>/dev/null; msg "$1 — $2"; }

exigir_fusion() {
    if [[ ! -e $MARCA ]]; then
        avisa "dotsync en pausa" "Falta la fusión inicial en este equipo ($EQ). Ver README del repo (sección PC)." critical
        exit 3
    fi
}

# Copia al repo lo que cambiaste en $HOME.
capturar() {
    local f t h
    while IFS= read -r f; do
        [[ -z $f || $f == \#* ]] && continue
        t="$HOME/$f"; h="$SRC/.hosts/$EQ/$f"
        [[ -f $t ]] || continue
        if ! cmp -s "$t" "$h"; then
            mkdir -p "$(dirname "$h")"; cp "$t" "$h"; msg "  [$EQ] $f"
        fi
    done < "$LISTA"
    chezmoi re-add 2>&1 | grep -v 'Detected a Generic API Key' || true   # comunes (no toca plantillas)
}

# Revisa que lo que se va a aplicar no rompa Hyprland ni configs JSON/TOML.
validar() {
    local tmp f ok=0; tmp=$(mktemp -d)
    while IFS= read -r f; do
        case $f in
            *.lua)  chezmoi cat "$HOME/$f" > "$tmp/x.lua" 2>/dev/null && { luac -p "$tmp/x.lua" 2>/dev/null || { msg "Lua inválido: $f"; ok=1; }; } ;;
            *.json) chezmoi cat "$HOME/$f" 2>/dev/null | python3 -c 'import json,sys;json.load(sys.stdin)' 2>/dev/null || [[ $f == *Code/User/settings.json ]] || { msg "JSON inválido: $f"; ok=1; } ;;
            *.toml) chezmoi cat "$HOME/$f" 2>/dev/null | python3 -c 'import tomllib,sys;tomllib.loads(sys.stdin.read())' 2>/dev/null || { msg "TOML inválido: $f"; ok=1; } ;;
        esac
    done < <(chezmoi managed --include=files | grep -E '^\.config/(hypr|noctalia|hyprwhspr)/.*\.(lua|json|toml)$|^\.local/state/noctalia/')
    rm -rf "$tmp"; return $ok
}

commit_local() {
    git -C "$SRC" add -A
    if ! git -C "$SRC" diff --cached --quiet; then
        local nombres; nombres=$(git -C "$SRC" diff --cached --name-only | xargs -n1 basename | sed 's/\.tmpl$//' | sort -u | head -4 | paste -sd, -)
        git -C "$SRC" commit -qm "$EQ $(date '+%F %R'): $nombres"
        msg "guardado: $nombres"
    fi
}

traer() {
    git -C "$SRC" fetch -q origin || { msg "sin internet, lo intento luego"; return 4; }
    if ! git -C "$SRC" rebase -q origin/main 2>/dev/null; then
        git -C "$SRC" rebase --abort 2>/dev/null
        avisa "dotsync: CONFLICTO" "Editaste lo mismo en la PC y en la laptop. No se sobrescribió nada. Abre Claude y dile: 'resuelve el conflicto de dotsync'." critical
        return 2
    fi
}

aplicar() {
    if ! validar; then
        avisa "dotsync: cambios NO aplicados" "La config que llegó tiene errores (ver: dotsync bajar). Tu escritorio sigue igual." critical
        return 5
    fi
    local cambios; cambios=$(chezmoi diff 2>/dev/null | grep -c '^diff --git' || true)
    if [[ ${cambios:-0} -gt 0 ]]; then
        chezmoi apply --force && systemctl --user daemon-reload
        avisa "dotsync" "Se aplicaron $cambios archivo(s) del otro equipo."
    fi
}

subir() { capturar; commit_local; traer || return $?; git -C "$SRC" push -q origin HEAD:main && msg "subido ✔"; }

case "${1:-auto}" in
    auto)   exigir_fusion; subir || exit $?; aplicar ;;
    subir)  exigir_fusion; subir ;;
    bajar)  exigir_fusion; capturar; commit_local; traer || exit $?; aplicar; git -C "$SRC" push -q origin HEAD:main ;;
    estado) echo "Equipo: $EQ   Repo: $SRC"; capturar >/dev/null 2>&1; git -C "$SRC" status --short | sed 's/^/  sin subir: /'
            git -C "$SRC" fetch -q origin 2>/dev/null && git -C "$SRC" log --oneline HEAD..origin/main | sed 's/^/  por bajar: /'
            [[ -e $MARCA ]] || echo "  ⚠ falta la fusión inicial en este equipo" ;;
    activar)    exigir_fusion; systemctl --user enable --now dotsync.timer && msg "automático activado (cada 30 min y al iniciar)" ;;
    desactivar) systemctl --user disable --now dotsync.timer && msg "automático desactivado" ;;
    *) sed -n '2,13p' "$0"; exit 1 ;;
esac

# Archivos del repo que NO van a $HOME
README.md
CLAUDE.md
docs/
laptop/
pc/
windows/

# Solo laptop: lógica de monitores dinámica (la PC tiene 2 monitores fijos)
{{ if and (ne .equipo "laptop") (ne .equipo "surface") }}
.config/hypr/config/escritorios.lua
.config/mpv/scripts/bateria.lua
{{ end }}

# Solo PC: mouse Corsair Scimitar (keyd) y teclado Corsair (ckb-next)
{{ if ne .equipo "pc" }}
.config/hypr/scripts/mouse-accion.sh
.config/hypr/scripts/mouse-lib.sh
.config/hypr/scripts/mouse-modo.sh
.config/hypr/keyd-scimitar.conf
.config/ckb-next/
.config/autostart/ckb-next.autostart.desktop
{{ end }}

# Nunca sincronizar (datos/estado propio de cada equipo)
.local/state/mpv/
.config/opendeck/plugins/
.local/share/icons/

# Binarios de uosc para otros sistemas
.config/mpv/scripts/uosc/bin/ziggy-windows.exe
.config/mpv/scripts/uosc/bin/ziggy-darwin

